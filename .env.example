# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Optional. Without a key the built-in summary works offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional; SQLite in instance/ is the default.
# DATABASE_URL=sqlite:///cost_analyzer.db
